# Copy this file to .env.local and fill in real values. Never commit .env.local
# (it's already in .gitignore) — this file only holds placeholder names.

# --- Supabase (required to run the app at all) -------------------------------
# Project Settings > API Keys in your Supabase dashboard. Supabase's newer
# "publishable" / "secret" key naming replaces the old anon/service_role
# terms — if your dashboard still shows "anon public" / "service_role",
# those are the same keys, just older naming.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Anthropic (required for AI outreach drafts, Phase 1 item 6) ------------
# console.anthropic.com > API Keys
ANTHROPIC_API_KEY=
# Optional override, defaults to claude-sonnet-5 in code.
ANTHROPIC_MODEL=

# --- Google Places API (required to pull prospects, Phase 1 item 1) ---------
# console.cloud.google.com > APIs & Services > enable "Places API (New)" >
# Credentials > Create API key. Restrict the key to the Places API only.
GOOGLE_PLACES_API_KEY=

# --- Resend (required to actually send cold outreach — drafting/review ------
# works without it) resend.com/api-keys. OUTREACH_FROM_EMAIL must be on a
# domain verified in Resend; leave both blank to keep outreach in
# draft-only/mock mode.
RESEND_API_KEY=
OUTREACH_FROM_EMAIL=

# --- OpenPhone (Phase 2+, not used by anything in Phase 1) ------------------
# Leave blank until Phase 2 — the app falls back to a mock SMS provider
# that never sends anything real.
OPENPHONE_API_KEY=
OPENPHONE_FROM_NUMBER=
OPENPHONE_WEBHOOK_SIGNING_SECRET=
